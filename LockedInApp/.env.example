# ─── Environment variable template ───────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER put real secrets in this file — it IS committed to version control.

# Your machine's LAN IP for physical device testing via Expo Go
# Run `ipconfig` (Windows) or `ifconfig` (Mac/Linux) to find it.
EXPO_PUBLIC_DEV_MACHINE_IP=

# Production backend URL (used in release/production builds)
EXPO_PUBLIC_PROD_API_URL=https://lockedin-hneu.onrender.com
